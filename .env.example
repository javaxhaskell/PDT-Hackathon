# PairScope environment — copy to backend/.env or export in your shell.
# No secrets are committed to this repository.

# DeepSeek Narrative Lens (optional — the quant analysis works without it)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# CORS origins allowed to call the backend (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Frontend: base URL of the backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
